# ==== General ====
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==== Postgres ====
POSTGRES_USER=govropk
POSTGRES_PASSWORD=govropk_pass
POSTGRES_DB=govropk
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://govropk:govropk_pass@postgres:5432/govropk

# ==== Qdrant Cloud ====
QDRANT_URL=https://your-cluster-url.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=govropk_gov_docs

# ==== LLM Provider ====
# "groq" = Groq API (default), "openai" = OpenAI API
LLM_PROVIDER=groq

# ==== Groq (get a key at https://console.groq.com/keys) ====
# openai/gpt-oss-120b is hosted by Groq; keep LLM_PROVIDER=groq for this model.
GROQ_API_KEY=gsk-your-groq-key
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# ==== OpenAI (only needed if LLM_PROVIDER=openai) ====
OPENAI_API_KEY=sk-your-openai-key
OPENAI_CHAT_MODEL=gpt-4o-mini

# ==== Embeddings (local, free, no key needed — FastEmbed/ONNX, runs inside the backend container) ====
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==== Tavily ====
TAVILY_API_KEY=tvly-your-tavily-key

# ==== LangSmith ====
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-your-langsmith-key
LANGCHAIN_PROJECT=govropk
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ==== JWT ====
JWT_SECRET_KEY=change_this_super_secret_key_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==== MCP ====
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8765

# ==== Frontend ====
VITE_API_BASE_URL=http://localhost:8000/api
CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:5173"]